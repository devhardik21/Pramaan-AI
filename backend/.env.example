NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/pramaanai

# JWT secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Upload limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads

# Python processor service URL
PROCESSOR_URL=http://127.0.0.1:8001

# Optional: OpenAI or Ollama endpoint for RAG answer generation
# Leave blank to use passage-retrieval only (no LLM answer generated)
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Admin seeder (used only by scripts/seed-admin.js, not exposed via API)
ADMIN_EMAIL=admin@pramaanai.local
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=System Administrator
