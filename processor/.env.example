PROCESSOR_PORT=8001

# Path to Tesseract binary (Windows example)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# OCR confidence threshold below which a field is marked 'extraction_uncertain'
OCR_CONFIDENCE_THRESHOLD=60

# Vector store directory (relative to processor/)
VECTOR_STORE_DIR=./vector_store

# Optional: LLM for RAG answer generation
# Leave blank to use passage retrieval only
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

# MongoDB (for writing back extracted fields)
MONGO_URI=mongodb://127.0.0.1:27017/pramaanai
